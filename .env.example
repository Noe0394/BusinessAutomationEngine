# Variables d'environnement du moteur LLM Multi-Provider Fallback
# (lib/ai/llmFallbackEngine.js) — cascade Groq -> Gemini -> Hugging Face ->
# Pollinations (public, sans clé, toujours disponible en dernier recours).
#
# Chacune de ces 3 clés est FACULTATIVE : une clé absente fait simplement
# sauter le fournisseur correspondant dans la cascade, sans jamais faire
# planter l'application (voir lib/ai/llmFallbackEngine.js#generateAIResponse).
#
# NOTE : ce fichier ne documente que les clés de ce moteur — le reste de la
# configuration de CYRUS SUPER ASSISTANT (WhatsApp, Telegram, Facebook,
# YouTube/TikTok, GitHub, admin...) est lu directement depuis process.env
# ailleurs dans le code et n'est pas encore consolidé ici.

# https://console.groq.com/keys
GROQ_API_KEY=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# https://openrouter.ai/keys — cascade : Groq -> Gemini -> OpenRouter ->
# Hugging Face -> Pollinations (voir lib/ai/llmFallbackEngine.js).
OPENROUTER_API_KEY=

# Facultatif — slug de modèle OpenRouter (avec suffixe ":free" pour le
# niveau gratuit). Les modèles gratuits OpenRouter changent régulièrement
# (voir openrouter.ai/models) — défaut : "meta-llama/llama-3.3-70b-instruct:free".
OPENROUTER_MODEL=

# Variables d'environnement du Studio Vidéo IA (image-to-video LTX-Video,
# voir lib/media/videoAiEngine.js) — cascade Fal.ai -> Replicate -> Hugging
# Face, chacune FACULTATIVE (clé absente = fournisseur sauté). Si aucune
# n'est configurée, le bouton "Générer vidéo IA" du dashboard renvoie une
# erreur claire et l'export Ken Burns 100% client (gratuit, sans clé) reste
# disponible normalement dans le Studio Vidéo.
#
# Le niveau Hugging Face (réutilise HUGGINGFACE_API_KEY ci-dessus, aucune
# clé dédiée) est un essai "best effort" NON GARANTI : Hugging Face n'expose
# officiellement que la tâche "Text to Video" dans son système Inference
# Providers, pas d'"Image to Video" documenté — un échec de ce niveau bascule
# simplement sur l'export Ken Burns local, sans jamais planter l'application.

# https://fal.ai/dashboard/keys
FAL_KEY=

# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Facultatif — slug de modèle fal.ai à utiliser si le défaut codé dans
# videoAiEngine.js ("fal-ai/ltx-video-13b-distilled/image-to-video") venait à
# être retiré/renommé côté fal.ai, sans avoir à modifier le code.
FAL_LTX_MODEL_ID=

# Facultatif — équivalent pour Replicate (défaut : "lightricks/ltx-video").
REPLICATE_LTX_MODEL=

# Facultatif — équivalent pour le niveau Hugging Face best-effort ci-dessus
# (défaut : "Lightricks/LTX-Video").
HF_LTX_MODEL_ID=

# Facultatif — Space Gradio public utilisé en repli si l'API Inference
# classique ci-dessus échoue (voir videoAiEngine.js#callHfGradioSpace,
# nécessite le paquet @gradio/client). Défaut :
# "Lightricks/LTX-Video-Playground" — AUCUNE garantie de disponibilité
# (démo communautaire/officielle, peut être en veille ou changer de schéma
# sans préavis).
HF_LTX_SPACE_ID=

# Facultatif — Space Gradio pour le moteur "LTX-2" sélectionnable
# explicitement dans le Studio Vidéo IA (vidéo + audio synchronisé nativement,
# voir videoAiEngine.js). Défaut : "Lightricks/ltx-2" — même absence de
# garantie de disponibilité que HF_LTX_SPACE_ID ci-dessus.
LTX2_SPACE_ID=

# https://dashboard.render.com/u/settings#api-keys — utilisée par
# scripts/keep_alive_recovery.js pour redémarrer le service via l'API Render
# si /ping ne répond plus (cron externe, hors du service lui-même).
# RENDER_SERVICE_ID a déjà une valeur par défaut dans le script (celle de ce
# projet) : à définir seulement si différente.
RENDER_API_KEY=
RENDER_SERVICE_ID=

# https://github.com/settings/tokens — utilisé par githubStore.js pour la
# sauvegarde de secours des licences/sessions sur un dépôt GitHub dédié (voir
# CLAUDE.md). GITHUB_DATA_REPO (format "owner/repo") est nécessaire EN PLUS
# du token pour activer cette sauvegarde.
GITHUB_TOKEN=
GITHUB_DATA_REPO=
GITHUB_DATA_BRANCH=
