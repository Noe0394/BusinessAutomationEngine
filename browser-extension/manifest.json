{
  "manifest_version": 3,
  "name": "CYRUS — Pont WhatsApp & Telegram Web",
  "version": "1.1.0",
  "description": "Permet au mode Local de CYRUS SUPER ASSISTANT d'envoyer réellement des messages WhatsApp et Telegram depuis le navigateur, sans clic manuel.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["tabs", "scripting"],
  "host_permissions": ["https://web.whatsapp.com/*", "https://web.telegram.org/*"],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["injected-bridge.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://web.telegram.org/*"],
      "js": ["injected-bridge-telegram.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://web.whatsapp.com/*", "https://web.telegram.org/*"],
      "js": ["content-relay.js"],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://cyrus-super-assistant.vercel.app/*",
      "https://*.vercel.app/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
