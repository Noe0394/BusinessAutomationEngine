# Port d'écoute HTTP — Koyeb fournit généralement sa propre valeur via PORT,
# sinon 8000 par défaut (voir index.js).
PORT=8000

# Secret partagé OBLIGATOIRE en production : protège /status, /qr, /send,
# /send-media, /pairing-code et /logout (en-tête x-shared-secret). Sans lui,
# ces routes restent accessibles sans authentification (avertissement au
# démarrage) — à ne jamais laisser vide sur un déploiement public.
SHARED_SECRET=

# URL HTTP vers laquelle ce service transmet les événements (message reçu,
# QR généré, connexion établie, session réinitialisée) — voir
# forwardToWebhook() dans index.js. Laisser vide pour désactiver (les
# événements sont alors seulement journalisés côté serveur).
WEBHOOK_URL=

# Sauvegarde de secours de la session WhatsApp (creds.json) sur un repo
# GitHub dédié — mêmes variables que le backend principal (voir
# .env.example à la racine du dépôt), nécessaire ici car Koyeb free tier
# n'offre pas de disque persistant par défaut : sans elles, un redémarrage
# du service perd la session et impose un nouvel appairage.
GITHUB_TOKEN=
GITHUB_DATA_REPO=
GITHUB_DATA_BRANCH=

# Dossier local de session Baileys (creds + clés Signal) — laisser la
# valeur par défaut sauf besoin spécifique.
AUTH_DIR=auth_info_baileys
