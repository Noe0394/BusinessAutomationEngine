# Copiez ce fichier en ".env" dans ce même dossier (local-client/) avant de
# lancer "npm start" — jamais committé (voir .gitignore).

# Clé de licence CYRUS SUPER ASSISTANT attribuée à ce client (générée depuis
# le portail admin du VPS central, voir /admin-secret-portal côté racine).
LICENSE_KEY=

# URL publique HTTPS du VPS central (backend principal racine, PAS le
# micro-service server/) — sert uniquement à la vérification de licence
# (/api/auth/verify-key) et à la passerelle IA (/api/ai/generate-text,
# /api/media/generate-image) : aucune donnée WhatsApp ne transite par là.
VPS_BASE_URL=https://34-135-20-27.sslip.io

# Port HTTP local sur lequel ce client sert son propre dashboard (ouvert
# automatiquement dans le navigateur par défaut au démarrage).
LOCAL_PORT=4100

# Telegram (MTProto/GramJS, voir lib/telegram.js) — identifiants de
# l'APPLICATION Telegram (pas du compte), à créer une seule fois sur
# https://my.telegram.org > API development tools. Mêmes valeurs que
# TELEGRAM_API_ID/TELEGRAM_API_HASH à la racine du dépôt (partagées par
# construction, voir adapters/telegram.js) — sans elles, l'onglet Telegram
# reste inactif (503 sur /api/telegram/*).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ---------------------------------------------------------------------------
# Failover (mode dégradé si le VPS ne répond pas) — voir lib/failover.js et
# ../firebase-functions/. Toutes facultatives : sans elles, une panne VPS
# bloque simplement l'accès (comportement précédent), au lieu de basculer.
# Valeurs affichées en fin de "firebase deploy --only functions" une fois le
# projet Firebase créé (voir ../firebase-functions/README.md).
# ---------------------------------------------------------------------------
FIREBASE_LICENSE_URL=
# Licences sur Cloudflare (voie principale quand renseignée ; Firebase puis VPS en repli)
CLOUDFLARE_LICENSE_URL=
FIREBASE_TEXT_URL=
FIREBASE_IMAGE_URL=
# Vidéo IA (image-to-video) — Firebase UNIQUEMENT, aucun repli VPS pour
# cette fonctionnalité (jamais exposée côté VPS à ce client).
FIREBASE_VIDEO_START_URL=
FIREBASE_VIDEO_POLL_URL=

# Mise à jour silencieuse (voir launcher.js) — Firebase en premier, VPS
# (/api/check-update) en repli. Public, sans authentification licence.
FIREBASE_UPDATE_URL=

# ---------------------------------------------------------------------------
# Chat-Driven Agent Orchestrator (portage local, voir ai-engine/ dans ce
# dossier + docs/PARITE-LOCAL.md à la racine du dépôt pour la référence VPS).
# ---------------------------------------------------------------------------

# Pourcentage de remise maximal que l'Agent peut accorder sans validation du
# vendeur (NEGOTIATE_DISCOUNT, ai-engine/emotionalCloser.js). Défaut : 15.
MAX_DISCOUNT_PERCENT=

# Instruction de paiement Mobile Money (GENERATE_PAYMENT_LINK) — mêmes
# variables que côté VPS (voir .env.example à la racine du dépôt). Chacune
# FACULTATIVE : un opérateur sans numéro est simplement absent du message.
MOBILE_MONEY_ORANGE=
MOBILE_MONEY_MTN=
MOBILE_MONEY_MOOV=
MOBILE_MONEY_WAVE=
MOBILE_MONEY_BENEFICIARY_NAME=

# Moteur de Closing Humanisé (ai-engine/emotionalCloser.js) — répond
# AUTOMATIQUEMENT aux messages WhatsApp/Telegram entrants classés
# 'business'. FACULTATIF, désactivé par défaut (jamais d'envoi automatique
# à de vrais clients sans activation explicite). Mettre exactement "true"
# pour l'activer.
AUTO_CLOSE_PROSPECTS=

# Auto-accueil des NOUVEAUX contacts (message de bienvenue au 1er message).
# Désactivé par défaut ; "true" pour activer. Texte = profil welcomeMessage /
# WELCOME_MESSAGE / défaut.
AUTO_ENGAGE_NEW_CONTACTS=
WELCOME_MESSAGE=
# Accusé de réception auto au client sur preuve de paiement (Human-in-the-Loop).
# La fiche admin est toujours créée ; "true" active l'accusé auto au client.
AUTO_PAYMENT_VALIDATION=

# Connecteurs de plateforme (ai-engine/connectors/) — mêmes clés que le VPS.
# Clé API de VOTRE plateforme (passerelle X-API-Key, ex. RIEA agent-gateway).
CYRUS_PLATFORM_API_KEY=
# System.io (désactivé par défaut dans active_connectors.json).
SYSTEME_IO_API_KEY=

# Tâches récurrentes : décalage horaire (heures) heure serveur -> heure locale
# "chaque matin à 7h". Défaut 0 (GMT).
RECURRING_TZ_OFFSET_HOURS=

# Traitement vocal (ai-engine/voiceProcessor.js) — transcription des notes
# vocales WhatsApp/Telegram/tchat. Contrairement au reste de l'IA (texte/
# image, voir lib/aiGateway.js), la transcription/synthèse audio n'a PAS
# encore d'équivalent Firebase : ces clés sont lues DIRECTEMENT ici (usage
# strictement local, votre propre PC — jamais transmises ni exposées).
# Transcription (Speech-to-Text) :
GROQ_API_KEY=
GROQ_WHISPER_MODEL=
GEMINI_API_KEY=
# Synthèse vocale (Text-to-Speech) — facultatif, sans l'une de ces 2 clés
# l'Agent répond en texte même à une note vocale (dégradation propre).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
GOOGLE_TTS_API_KEY=
