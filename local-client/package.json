{
  "name": "cyrus-local-client",
  "version": "1.0.0",
  "description": "Application PC installable avec WhatsApp, Telegram et SQLite locaux. Cloudflare gère les licences et les passerelles IA média; aucun Firebase ni backend VPS central n'est requis.",
  "private": true,
  "main": "index.js",
  "bin": "index.js",
  "scripts": {
    "start": "node index.js",
    "build:exe": "pkg . --targets node22-win-x64 --output dist/cyrus-local-client.exe"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "node_modules/es-get-iterator/**/*",
      "node_modules/deep-equal/**/*"
    ]
  },
  "dependencies": {
    "axios": "^1.7.7",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "form-data": "^4.0.6",
    "open": "^8.4.2",
    "pdfkit": "^0.15.2",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "telegram": "^2.26.22",
    "whatsapp-web.js": "^1.26.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0"
  }
}
